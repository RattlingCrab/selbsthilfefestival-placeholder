# Vorlage. Die echten Werte gehoeren in die Umgebung des Stacks,
# NICHT in dieses Repo.

# Welches Image-Tag der Stack zieht. "prod" wandert nur bei Release-Tags.
IMAGE_TAG=prod

# Passwortschutz. Solange gesetzt, ist die Seite nicht oeffentlich.
# Zum Livegang: Zeile leeren oder loeschen und Stack neu starten.
SITE_BENUTZER=festival
SITE_PASSWORT=
